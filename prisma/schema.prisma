// JasMiamiMethod — Prisma schema
// Multi-user triathlon coaching platform (medical/human research based, 2000+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- IDENTITY ----------

model User {
  passwordReset PasswordReset?
  signInAccounts SignInAccount[]
  syncJobs SyncJob[]
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("athlete") // athlete | coach | admin
  timezone     String    @default("America/New_York")
  language     String    @default("en") // en | es | ht | fr | ru — new accounts start English; onboarding can change it
  avatar       String    @default("🧑") // emoji icon face
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile     AthleteProfile?
  sessions    AuthSession[]
  plans       TrainingPlan[]
  workouts    Workout[]
  metrics     DailyMetrics[]
  sleep       SleepRecord[]
  bloodPanels BloodPanel[]
  dnaResults  GeneticResult[]
  nutrition   NutritionLog[]
  hydration   HydrationLog[]
  connectors  Connector[]
  calendar    CalendarEvent[]
  motivation  MotivationPref?
  emails      SentEmail[]
  races       Race[]
  benchmarks  BenchmarkTest[]
  checkins    DailyCheckin[]
  supplement  SupplementProfile?
  reminder    ReminderPref?
  communication CommunicationPreference?
  coachingPrompts CoachingPrompt[]
  cognitive   CognitiveTest[]
  auditActions AuditLog[] @relation("AuditActor")
  auditSubjects AuditLog[] @relation("AuditSubject")
  onboarded     Boolean  @default(false) // first-time setup completed
  metricObservations MetricObservation[]
  coaching      CoachAssignment[] @relation("CoachSide") // athletes this user coaches
  coachedBy     CoachAssignment[] @relation("AthleteSide") // coaches assigned to this user
  forecastSnapshots RaceForecastSnapshot[]
  coachingMessages CoachingMessage[] @relation("MessageAthlete")
  authoredMessages CoachingMessage[] @relation("MessageAuthor")
  assistantConversation CoachConversation?
  assistantMessages CoachConversationMessage[]
  assistantProposals CoachConversationProposal[]
  assistantRequests CoachConversationRequest[]
}

// Identity only: provider access/refresh tokens are never persisted for login.
model SignInAccount {
  id       String @id @default(cuid())
  userId   String
  provider String
  issuer   String
  clientId String
  subject  String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([issuer, clientId, subject])
  @@index([userId])
}

// Short-lived, browser-bound, single-use authorization transactions.
model SignInTransaction {
  stateHash   String @id
  browserHash String
  provider    String
  clientId    String
  redirectUri String
  nonce       String
  verifier    String
  linkUserId  String?
  linkSessionHash String?
  expiresAt   DateTime
  @@index([expiresAt])
}

// Shared athlete/authorized-coach conversation. Messages do not execute plan edits.
model CoachingMessage {
  id String @id @default(cuid())
  athleteId String
  authorId String
  body String
  clientId String
  createdAt DateTime @default(now())
  athlete User @relation("MessageAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  author User @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  @@unique([authorId, clientId])
  @@index([athleteId, createdAt, id])
}

// Private athlete-only assistant history, separate from shared coach messages.
// Clearing chat removes messages; durable confirmation receipts and health audits remain.
model CoachConversation {
  id         String                      @id @default(cuid())
  userId     String                      @unique
  generation Int                         @default(0)
  revision   Int                         @default(0)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   CoachConversationMessage[]
  proposals  CoachConversationProposal[]
}

model CoachConversationMessage {
  id             String            @id @default(cuid())
  conversationId String
  userId         String
  role           String // user | assistant
  content        String
  source         String // text | voice | image | local
  metadata       String? // bounded provenance; never raw image bytes or credentials
  createdAt      DateTime          @default(now())
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId, createdAt, id])
}

model CoachConversationProposal {
  id              String            @id @default(cuid())
  conversationId  String
  userId          String
  generation      Int
  sourceMessageId String
  timezone        String
  revision        Int               @default(1)
  status          String            @default("pending") // pending | confirmed | review_required | cancelled | superseded
  candidates      String
  baseRevisions   String
  idempotencyKey  String?
  requestHash     String?
  receipt         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  confirmedAt     DateTime?
  conversation    CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, conversationId, generation, createdAt, id])
}

// Idempotency/concurrency ledger contains hashes and operational state only.
// Never persist prompts, image bytes, provider credentials or raw responses here.
model CoachConversationRequest {
  id String @id @default(cuid())
  userId String
  clientRequestId String
  requestHash String
  status String @default("processing") // processing | completed | failed | unknown
  activeKey String? @unique
  metered Boolean @default(false)
  conversationId String
  generation Int
  revision Int
  createdAt DateTime @default(now())
  finishedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, clientRequestId])
  @@index([userId, metered, createdAt])
}

// ---------- TELEMETRY & USAGE METERING ----------
// AppEvent: error/warn/info ledger (client errors, server 500s, cron
// outcomes). Critical errors trigger owner Telegram alerts (rate-limited).
model AppEvent {
  id        String   @id @default(cuid())
  kind      String   // error | warn | info
  source    String   // client | server | cron | sync | ai | delivery
  route     String?
  userId    String?
  message   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([route, createdAt])
}
// UsageCounter: per-user per-day consumption counters (AI calls/tokens,
// synced rows, exports, messages) — feeds the admin cost panel.
model UsageCounter {
  id     String @id @default(cuid())
  userId String
  day    String // YYYY-MM-DD (UTC)
  metric String // ai_calls | ai_input_tokens | ai_output_tokens | db_rows_synced | fit_exports | telegram_msgs | email_sends | gpx_uploads
  count  Int    @default(0)

  @@unique([userId, day, metric])
  @@index([day, metric])
}

// ---------- COACH ASSIGNMENTS (permission boundary) ----------
// A coach may only see/act on athletes with an ACTIVE assignment. Admins
// bypass (platform owners). consent tracks the athlete's view: admin-created
// assignments start "pending" — the athlete-facing grant/revoke toggle is the
// documented next step; revocation (status="revoked") cuts access immediately.
model CoachAssignment {
  id        String   @id @default(cuid())
  coachId   String
  athleteId String
  status    String   @default("active") // active | revoked
  consent   String   @default("pending") // pending | granted | revoked (athlete-facing)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coach     User @relation("CoachSide", fields: [coachId], references: [id], onDelete: Cascade)
  athlete   User @relation("AthleteSide", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([athleteId])
}

model PasswordReset {
  userId String @id
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- ATHLETE PROFILE & PHYSIOLOGY ----------

model AthleteProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  birthYear     Int?
  sex           String? // male | female
  heightCm      Float?
  weightKg      Float?
  weightSource  String? // manual | device — device sync may overwrite device-sourced weights only
  experience    String  @default("beginner") // beginner | amateur | advanced | pro
  goal          String? // sprint | olympic | half | full
  raceDate      DateTime?
  weeklyHours   Float   @default(8)
  intensityPct  Float?  // coach-set intensity multiplier % (null/100 = as planned; <100 eases, >100 sharpens)
  trainingWindow String @default("any") // any | morning | midday | evening — default session time-of-day
  units        String   @default("metric") // metric | imperial — display-only; storage stays kg/km/ml/°C
  manualPrs    String?  // JSON: user-entered personal records [{label, value, unit, date}] — track PBs etc. not capturable from devices
  vo2max        Float? // ml/kg/min (measured or estimated)
  lthr          Int?   // lactate threshold HR bpm
  restingHr     Int?
  maxHr         Int?
  ftp           Float? // functional threshold power W
  cp            Float? // critical power W
  wPrime        Float? // kJ
  swimPaceBase  Float? // sec/100m threshold
  runPaceBase   Float? // sec/km threshold
  // equipment & measurement stack (smart coach gear advice)
  bikeType       String? // road | tt | tri | gravel | mountain
  hasBikePowerMeter Boolean @default(false)
  hasRunPowerMeter   Boolean @default(false)
  hasBikeComputer    Boolean @default(false)
  hasAeroBars        Boolean @default(false)
  hasHrm             Boolean @default(false)
  hasGpsWatch        Boolean @default(false)
  hasSwimPaceTool    Boolean @default(false)
  hasSmartTrainer    Boolean @default(false)
  hasCadenceSensor   Boolean @default(false)
  hrvBaseline   Float? // ms
  sweatRateMlH  Float? // measured sweat rate ml/h (pre/post weight test) — fuel planning
  sodiumMgPerL  Float? // measured sweat sodium mg/L (sweat patch test)
  gutTrained    Boolean @default(false) // reported practice only; never establishes a dose
  nutritionContext String? // versioned dated practice, sweat provenance and session-scoped turnaround
  draftSkill    String? // none | mixed | good — open-water swim drafting
  federation    String? // USAT | WORLD_TRIATHLON | BRITISH_TRIATHLON | IRONMAN — wetsuit rules
  category      String? // age_group | elite
  injured       Boolean @default(false)
  notes         String?
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- TRAINING PLAN ----------

model TrainingPlan {
  id          String   @id @default(cuid())
  userId      String
  name        String
  level       String   // beginner | amateur | advanced | pro
  distance    String   // sprint | olympic | half | full
  weeks       Int
  startDate   DateTime
  raceDate    DateTime?
  status      String   @default("active") // active | completed | archived
  tssTarget   Float?
  easyPct     Int      @default(70) // target % of weekly minutes in Z1-Z2 (rest = quality); manual-adjustable at generation
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        PlanDay[]

  @@index([userId, status, startDate])
}

model PlanDay {
  id        String       @id @default(cuid())
  planId    String
  date      DateTime
  week      Int
  dayOfWeek Int
  focus     String? // swim | bike | run | strength | recovery | rest
  notes     String?
  dayOff    Boolean  @default(false) // picked rest day: 20 min Z1 + breathing protocol replaces planned sessions
  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions  Workout[]

  @@index([planId, date])
}

// ---------- WORKOUTS ----------

model Workout {
  id         String   @id @default(cuid())
  userId     String
  planDayId  String?
  date       DateTime
  startTime  String?  // "HH:mm" — preferred time-of-day for this session (athlete-pickable)
  sport      String   // swim | bike | run | strength | mobility | recovery | brick
  title      String
  type       String   // interval | tempo | endurance | threshold | recovery | strength | skill
  durationMin Int
  distanceKm Float?
  intensity  String?  // z1..z5, rpe
  rpe        Int?     // 1-10
  tss        Float?
  planned    Boolean  @default(true)
  completed  Boolean  @default(false)
  approved   Boolean  @default(false) // athlete approved → .FIT generated for watch import
  regenCount Int      @default(0) // workout regenerations used (max 3)
  notes      String?
  avgHr      Int?
  maxHr      Int?
  avgPower   Float?
  np         Float?
  calories   Int?
  source     String?  // manual | plan | strava | garmin | apple | whoop
  externalId String?
  indoor     Boolean  @default(false) // moved indoors → no heat/weather adjustment
  preWeightKg  Float?  // pre-session body weight (hydration tracking)
  postWeightKg Float?  // post-session body weight
  recovery     String? // post-workout ANS recovery cooldown note (rotates daily)
  originalPlan String? // immutable base used when recalculating daily adaptations
  prescription String? // effective structured prescription shared by UI/export
  feedbackStatus String? // completed | partial | substituted | skipped | unknown
  actualDurationMin Int?
  actualSport       String? // Explicit athlete report; never overwrites planned sport
  actualDetails     String? // Versioned JSON: reported quantities and observation provenance
  feedbackNote String?
  feedbackAt DateTime?
  matchedPlanId String? // planned session fulfilled by an imported activity
  deliveryProvider String? // intervals | garmin-json — where this prescription was published
  deliveryId String? // provider-side id of the published workout (updates/deletes)
  insights String? // KCoach activity report (JSON {headline, body}) generated at sync
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDay    PlanDay? @relation(fields: [planDayId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, source, externalId])
}

// ---------- METRICS: SLEEP / HRV / RECOVERY ----------

model DailyMetrics {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  hrv           Float?   // ms (RMSSD)
  hrvType       String?  // rmssd | sdnn; never combine different measurement types
  restingHr     Int?
  sleepScore    Int?     // 0-100
  recoveryScore Int?     // 0-100 readiness
  stressScore   Int?     // 0-100
  energy        Int?     // 0-100
  rhr           Int?
  weightKg      Float?
  bodyFat       Float?
  sleepHours    Float?
  source        String?  // whoop | aura | apple | garmin | manual
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model SleepRecord {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  bedTime       DateTime?
  wakeTime      DateTime?
  hours         Float
  deepHours     Float?
  remHours      Float?
  lightHours    Float?
  awakenings    Int?
  efficiency    Float?   // 0-100
  quality       Int?     // 0-100
  source        String?  // whoop | aura | apple | garmin | manual
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ---------- BLOOD PANELS ----------

model BloodPanel {
  id        String       @id @default(cuid())
  userId    String
  date      DateTime
  lab       String?
  note      String?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  results   BloodResult[]
}

model BloodResult {
  id           String     @id @default(cuid())
  panelId      String
  marker       String     // e.g. "Ferritin", "Vitamin D", "Hemoglobin"
  value        Float
  unit         String?
  refLow       Float?
  refHigh      Float?
  panel        BloodPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  notes        String?
}

// ---------- DNA ----------

model GeneticResult {
  id        String    @id @default(cuid())
  userId    String
  uploadedAt DateTime @default(now())
  provider  String    // 23andme | ancestry | raw
  fileName  String?
  summary   String?   // JSON: trait genotypes
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants  GeneticVariant[]
}

model GeneticVariant {
  id         String    @id @default(cuid())
  dnaResultId String
  rsid       String
  gene       String?
  genotype   String
  trait      String?
  impact     String?   // beneficial | neutral | caution
  note       String?
  dnaResult  GeneticResult @relation(fields: [dnaResultId], references: [id], onDelete: Cascade)
}

// ---------- NUTRITION & HYDRATION ----------

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  meal      String?  // breakfast | lunch | dinner | snack | fuel
  food      String
  calories  Int?
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  waterMl   Int?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HydrationLog {
  id      String   @id @default(cuid())
  userId  String
  date    DateTime
  ml      Int
  source  String?  // water | sports drink | electrolytes
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- CONNECTORS ----------

model Connector {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // whoop | aura | apple | garmin | strava | withings
  status      String   @default("disconnected") // connected | disconnected | error
  tokenEnc    String?  // encrypted access token
  refreshEnc  String?
  expiresAt   DateTime?
  scope       String?
  externalRef String?  // provider-side athlete id (e.g. Strava athlete_id) for webhook matching
  lastSyncAt  DateTime?
  lastSyncCount Int?
  lastError String?
  syncStartedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ---------- CALENDAR & MOTIVATION ----------

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  title     String
  date      DateTime
  startTime String?
  endTime   String?
  type      String   // workout | race | appointment | note
  notes     String?
  externalId String?
  workoutId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@unique([userId, workoutId])
  @@index([userId, date])
}

// Administrative changes are attributable; no passwords or connector tokens here.
model AuditLog {
  id String @id @default(cuid())
  actorId String
  subjectId String
  action String
  entityId String?
  before String?
  after String?
  note String?
  createdAt DateTime @default(now())
  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  subject User @relation("AuditSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, createdAt])
}

model ReminderDelivery {
  attempts Int @default(0)
  lastAttemptAt DateTime?
  id String @id @default(cuid())
  userId String
  day String
  channel String
  status String
  error String?
  createdAt DateTime @default(now())
  @@unique([userId, day, channel])
}

model MotivationPref {
  id        String @id @default(cuid())
  userId    String @unique
  dailyQuote Boolean @default(true)
  emailDigest Boolean @default(true)
  digestHour Int    @default(6)
  style     String @default("coach") // coach | science | tough | gentle
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SentEmail {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  to        String
  status    String   // sent | failed
  error     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- RACES (goal + calendar + temperature) ----------

model Race {
  id          String   @id @default(cuid())
  userId      String
  name        String
  distance    String   // sprint | olympic | half | full | hyrox
  date        DateTime
  startTime   String?  // "07:30"
  location    String?
  lat         Float?   // venue latitude (auto-geocoded from location)
  lng         Float?   // venue longitude
  targetTempC Float?   // expected race-day temperature (for heat adjustment)
  humidity    Float?   // % (optional — folded into heat index)
  baseElevM   Float?   // venue base elevation (thin-air altitude)
  goalTimeMin Float?   // target finish time in minutes
  resultMin  Float?     // ACTUAL finish time logged after the race - feeds prediction accuracy tracking
  priority    Int      @default(1) // 1 = A-race (anchor), 2 = B, 3 = C
  bikeElevM   Float?   // total climb on the bike leg (m)
  bikeTerrain String?  // flat | rolling | hilly | mountain
  runElevM    Float?   // total climb on the run leg (m)
  runTerrain  String?  // flat | rolling | hilly | trail
  swimVenue   String?  // pool | lake | ocean | river
  waterTempC  Float?   // swim water temperature (°C)
  swimCurrent String?  // none | mild | strong
  federation  String?  // USAT | WORLD_TRIATHLON | BRITISH_TRIATHLON | IRONMAN
  category    String?  // age_group | elite
  courseKm    Float?   // measured course distance from uploaded GPX (overrides the distance label in forecasts)
  courseElevM Float?   // measured total elevation gain from uploaded GPX
  elevProfile String?  // JSON [{km,elevM}] sampled from GPX — per-segment pacing
  source      String?  // provenance: "manual" | "athlinks" | ... — who created the record
  sourceRecordId String? // provider-side result id (dedupe across re-imports)
  sourceRetrievedAt DateTime? // when the provider record was last pulled
  notes       String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@unique([userId, source, sourceRecordId])
}

// ---------- OAUTH TRANSACTIONS (mobile-safe connector returns) ----------
// Maps the OAuth `state` to the Jasmethod user + return URL server-side, so
// the callback does not depend on browser cookies (in-app mobile browsers
// drop them). One row per authorization attempt; usedAt marks consumption.
model OAuthTransaction {
  id        String   @id @default(cuid())
  state     String   @unique
  userId    String
  provider  String   // whoop | strava | google-cal | oura
  returnUrl String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  @@index([userId, provider])
}

// ---------- WEBHOOK EVENT LEDGER (dedupe + async processing) ----------
// Every webhook POST is persisted before processing (2xx returned fast);
// eventId/trace_id uniqueness makes redelivery a no-op.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String   // whoop | strava
  eventId    String   // whoop trace_id / event id, strava event id
  payload    String?  // raw JSON for later async processing / audit
  receivedAt DateTime @default(now())
  processedAt DateTime?
  @@unique([provider, eventId])
}

// ---------- SCHEDULED TESTING (FTP/LTHR/CP benchmarks) ----------

model BenchmarkTest {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  type      String   // ftp | lthr | cp | run5k | swim
  name      String
  result    Float?   // measured value (W / bpm / sec / time)
  skipped   Boolean  @default(false)
  reason    String?
  completed Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ---------- DAILY CHECK-IN (questionnaire → adaptation) ----------

model DailyCheckin {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  answers    String?  // JSON: Checkin
  adaptation String?  // JSON: Adaptation
  fuel       String?  // JSON: FuelPlan
  ergos      String?  // JSON: string[] of ergo keys recommended
  shadowV2   String?  // JSON: AthleteStateV2 + ShadowComparison — auditable V2 shadow output
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ---------- PRE-RACE FORECAST SNAPSHOTS (honest calibration) ----------
// Immutable point-in-time record of what the engine predicted BEFORE the
// race, with the inputs and version used. Accuracy is evaluated against the
// OLDEST snapshot per race — never recomputed with today's fitness.
model RaceForecastSnapshot {
  id           String   @id @default(cuid())
  userId       String
  raceId       String
  raceDate     DateTime
  capturedAt   DateTime @default(now())
  predictedMin Float    // central expected finish
  bestMin      Float?
  worstMin     Float?
  inputs       String?  // JSON: fitness/CTL, weather, course, athlete params at capture time
  engineVersion String  // engine tag so future rewrites stay comparable
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, raceId, capturedAt])
}

// ---------- SUPPLEMENT / ERGOGENIC PREFERENCES ----------

model SupplementProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  enabled  Boolean @default(true) // master switch — off = never recommend anything
  likes    String? // JSON: string[]
  dislikes String? // JSON: string[]
  optsOut  String? // JSON: string[]
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- TRAINING REMINDERS (email / telegram) ----------

model ReminderPref {
  id              String  @id @default(cuid())
  userId          String  @unique
  emailEnabled    Boolean @default(false)
  telegramEnabled Boolean @default(false)
  telegramChatId  String?
  reminderHour    Int     @default(17) // 0-23 local; <12 = morning reminder, >=12 = evening detailed plan for tomorrow
  remindBeforeMin Int     @default(0) // extra lead time before the session
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Cognitive training results (Stroop, Reaction Time) — the "brain training" pillar.
model CognitiveTest {
  id        String   @id @default(cuid())
  userId    String
  test      String   // stroop | reaction | memory
  score     Float    // e.g. stroop: avg response ms; reaction: avg ms; memory: correct/10
  accuracy  Float?   // 0-100
  date      DateTime @default(now())
  notes     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model MetricObservation {
  id                String   @id @default(cuid())
  userId            String
  observedAt        DateTime
  metricType        String   // hrv_rmssd | hrv_sdnn | resting_hr | sleep_hours | weight_kg | body_temp | spo2 | ...
  value             Float
  unit              String?
  source            String   // whoop | garmin | oura | strava | manual | apple_health | coros
  measurementMethod String?  // optical_sensor | chest_strap | manual_entry | derived
  device            String?  // specific device model if known
  qualityFlag       String?  // ok | suspect | calibration_needed | incomplete
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, observedAt])
  @@index([userId, metricType, observedAt])
}

model SyncJob {
  id String @id @default(cuid())
  userId String
  kind String
  dedupeKey String @unique
  payload String
  status String @default("pending")
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leasedUntil DateTime?
  leaseToken String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, availableAt])
  @@index([userId, createdAt])
}


// Opt-in pilot communications. All delivery receipts are mock-only until review.
model CommunicationPreference {
  userId String @id
  primaryChannel String @default("app")
  paused Boolean @default(true)
  dailyPlan Boolean @default(false)
  sessionFeedback Boolean @default(false)
  missingData Boolean @default(false)
  timezone String
  minuteOfDay Int @default(1020)
  quietStart Int @default(1260)
  quietEnd Int @default(420)
  declinedOptional String @default("[]")
  verifiedChatId String? @unique
  verifiedActorId String?
  verifiedEmail String?
  verifiedAt DateTime?
  verificationTransport String?
  challengeHash String?
  challengeExpiresAt DateTime?
  consentVersion String?
  consentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachingPrompt {
  id String @id @default(cuid())
  userId String
  sessionId String
  purpose String
  channel String
  transport String @default("mock")
  observationDate String
  timezone String
  sourceRevision String
  sourceWorkoutRevision String
  idempotencyKey String @unique
  questions String
  message String
  status String @default("queued")
  attempts Int @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  receiptId String?
  error String?
  tokenHash String?
  tokenExpiresAt DateTime?
  tokenUsedAt DateTime?
  replyStatus String @default("none")
  candidate String?
  repliedAt DateTime?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
}

// At-most-once authenticated Telegram update ingestion. No message body retained.
model TelegramCoachingUpdate {
  id String @id
  status String @default("processing")
  createdAt DateTime @default(now())
  @@index([createdAt])
}
