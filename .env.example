# ── Database (Supabase Postgres) ─────────────────────────
# prisma/schema.prisma is already pinned to `provider = "postgresql"`.
# Supabase → Project Settings → Database → Connection string.
#   • DATABASE_URL = pooled connection (uses PgBouncer, port 6543, ?pgbouncer=true).
#     Prisma uses this for migrations/queries that tolerate transaction pooling.
#   • DIRECT_URL   = direct connection (port 5432, same credentials, no query params).
#     Prisma uses this for migrations (the CLI refuses to apply migrations over PgBouncer).
# Copy the "Transaction" pooler URL here and the "Session" (direct) URL for DIRECT_URL.
# Project ref: YOUR_PROJECT_REF · region: YOUR_REGION · DB user: postgres.YOUR_PROJECT_REF
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Apply the schema (creates all tables):  npx prisma migrate deploy
# Existing free-access athlete accounts remain unchanged. Grant additional admins with:
# npm run admin:grant -- exact-email
# One-shot wiring (builds both URLs + migrates + seeds):
#   SUPABASE_DB_PASSWORD='...' npx tsx scripts/setup-supabase.ts

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional AI: direct OpenAI API only; no provider fallback ──
EXTERNAL_AI_ENABLED="false"
OPENAI_TEXT_MODEL="gpt-4.1-mini-2025-04-14"
NUTRITION_PHOTO_ENABLED="false"
OPENAI_API_KEY=""
COACH_VISION_ENABLED="false"
# Legacy provider keys are ignored by this version. Do not reuse old consent.

# ── Email (SMTP) — required for real delivery ─────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ENABLE_MANUAL_WORKOUT_EMAIL="false"
# HTTPS origin only, no path/query. Athlete verification and consent still required.
MANUAL_WORKOUT_EMAIL_ORIGIN=""

# ── Reminders ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
ENABLE_TELEGRAM_COACHING="false"
ENABLE_AUTOMATED_DELIVERY="false"
COACHING_TRANSPORT="telegram"
# Generate a 32–256 character URL-safe random secret; register via admin checks.
TELEGRAM_COACHING_WEBHOOK_SECRET=""
# Public bot username (without @) — powers the one-click pairing link on the
# Reminders page (t.me/<username>?start=<code>).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""   # optional — enables Telegram reminders
CRON_SECRET=""          # protects /api/cron/reminders (any random string)

# ── Connectors (optional OAuth) ───────────────────────────
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
TERRA_API_KEY=""
TERRA_DEV_ID=""

# ── Seed ──────────────────────────────────────────────────
# Only enables the optional data seed on isolated development databases.
# The whitelisted free-access sign-in buttons do not depend on this setting.
ENABLE_LOCAL_DEMO=""

# Required for production OAuth token encryption; generate a long random secret.
TOKEN_ENCRYPTION_KEY=""
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
STRAVA_VERIFY_TOKEN=""
# Include ?key=<secret> when registering the Strava webhook callback URL.
STRAVA_WEBHOOK_SECRET=""
STRAVA_SUBSCRIPTION_ID=""
COACH_ENGINE_VERSION=v1

# --- Auth / admin bootstrap ---
# Comma-separated emails auto-promoted to role=admin on any sign-in path.
ADMIN_EMAILS=""
# Google Sign-In + Calendar connector (ONE Google Cloud OAuth client covers both;
# authorized redirect URIs: https://<domain>/api/auth/google/callback and
# https://<domain>/api/connectors/google-cal/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Athlinks race-history connector (server-side API key only — never exposed
# to the client; athletes link by confirming their Athlinks profile)
ATHLINKS_API_KEY=""
# Pin each provider's OAuth redirect URI to the EXACT value registered in the
# provider's developer dashboard (prevents "redirect_uri does not match"
# failures when the canonical domain changes):
WHOOP_REDIRECT_URI=""
STRAVA_REDIRECT_URI=""
GOOGLE_REDIRECT_URI=""
OURA_REDIRECT_URI=""

# Intervals.icu OAuth requires an approved app and a fresh, unexposed client secret.
# One app registration serves many athletes; each athlete consents separately.
# Register exactly: https://YOUR_APP_DOMAIN/api/connectors/intervals/callback
# Leave disabled until credentials, callbacks, jobs and acceptance tests are ready.
ENABLE_INTERVALS_CONNECTOR="false"
# Optional staged rollout: comma-separated JMM user IDs, maximum 50.
# Unset preserves the global switch; explicitly empty or malformed blocks all.
# INTERVALS_PILOT_USER_IDS="YOUR_PILOT_USER_ID"
INTERVALS_CLIENT_ID=""
INTERVALS_CLIENT_SECRET=""
INTERVALS_REDIRECT_URI=""
INTERVALS_WEBHOOK_SECRET=""
# Separate from communication delivery. Requires explicit athlete opt-in and
# a current-revision approval before publishing previously unpublished workouts.
ENABLE_INTERVALS_AUTO_PUBLISH="false"
# Uses TOKEN_ENCRYPTION_KEY above; required even in local OAuth development.
# Required scopes: ACTIVITY:READ,WELLNESS:READ,CALENDAR:WRITE (WRITE includes READ).
# Intervals.icu returns a Bearer access token; no API-key paste or refresh token.

# ── Public consultation bookings (optional; free Cal.com individual event) ──
# Set only after creating an actual Cal.com event, e.g. https://cal.com/YOUR_USERNAME/YOUR_EVENT.
# With no valid event URL, /book shows a truthful contact-request fallback.
NEXT_PUBLIC_CAL_BOOKING_URL=""
# Public /contact form uses the existing SMTP_* configuration above.
# Without SMTP_HOST/SMTP_FROM/SMTP_USER/SMTP_PASS, the form fails closed and offers a mailto draft.
