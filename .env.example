# ── Database ─────────────────────────────────────────────
# Local dev: SQLite file. Production (Vercel): switch prisma/schema.prisma
# `provider = "sqlite"` → `"postgresql"` and set a Supabase/Neon URL.
DATABASE_URL="file:./dev.db"

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI Coach (OpenRouter) — optional; falls back to rule-based ──
OPENROUTER_API_KEY=""
# Default: google/gemini-3.7-flash (fast, cheap, best multilingual).
# Alternatives: anthropic/claude-haiku-4.5 (best JSON), openai/gpt-4.1-mini.
OPENROUTER_MODEL="google/gemini-3.7-flash"

# ── Email (SMTP) — required for real delivery ─────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Reminders ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""   # optional — enables Telegram reminders
CRON_SECRET=""          # protects /api/cron/reminders (any random string)

# ── Connectors (optional OAuth) ───────────────────────────
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""

# ── Seed ──────────────────────────────────────────────────
# Set SEED_DEMO=true in production to create the demo@ account.
SEED_DEMO=""
