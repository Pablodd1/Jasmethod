# ── Database (Supabase Postgres) ─────────────────────────
# prisma/schema.prisma is already pinned to `provider = "postgresql"`.
# Supabase → Project Settings → Database → Connection string.
#   • DATABASE_URL = pooled connection (uses PgBouncer, port 6543, ?pgbouncer=true).
#     Prisma uses this for migrations/queries that tolerate transaction pooling.
#   • DIRECT_URL   = direct connection (port 5432, same credentials, no query params).
#     Prisma uses this for migrations (the CLI refuses to apply migrations over PgBouncer).
# Copy the "Transaction" pooler URL here and the "Session" (direct) URL for DIRECT_URL.
# Project ref: aycckjrkhgnwaggrrejp · region: us-east-1 · DB user: postgres.aycckjrkhgnwaggrrejp
DATABASE_URL="postgresql://postgres.aycckjrkhgnwaggrrejp:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.aycckjrkhgnwaggrrejp:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Apply the schema (creates all tables):  npx prisma migrate deploy
# Provision demo accounts:                npx tsx scripts/create-accounts.ts
# One-shot wiring (builds both URLs + migrates + seeds):
#   SUPABASE_DB_PASSWORD='...' npx tsx scripts/setup-supabase.ts

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI Coach (Google Gemini, direct API) — optional; falls back to rule-based ──
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Matches src/lib/coach.ts default. Point the key at whichever model you prefer —
# the code falls back to rule-based if the key is missing or the call fails.
GEMINI_MODEL="gemini-3.6-flash"

# ── Email (SMTP) — required for real delivery ─────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── Reminders ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""   # optional — enables Telegram reminders
CRON_SECRET=""          # protects /api/cron/reminders (any random string)

# ── Connectors (optional OAuth) ───────────────────────────
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
TERRA_API_KEY=""
TERRA_DEV_ID=""

# ── Seed ──────────────────────────────────────────────────
# Set SEED_DEMO=true in production to create the demo@ account.
SEED_DEMO=""
